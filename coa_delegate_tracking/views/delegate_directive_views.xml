<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Directive - List View -->
    <record id="view_delegate_directive_tree" model="ir.ui.view">
        <field name="name">delegate.directive.tree</field>
        <field name="model">delegate.directive</field>
        <field name="arch" type="xml">
            <list string="التوجيهات والتعليمات الإدارية">
                <field name="name"/>
                <field name="directive_type"/>
                <field name="target_type"/>
                <field name="is_active"/>
                <field name="create_date" string="تاريخ الإنشاء"/>
            </list>
        </field>
    </record>

    <!-- Directive - Form View -->
    <record id="view_delegate_directive_form" model="ir.ui.view">
        <field name="name">delegate.directive.form</field>
        <field name="model">delegate.directive</field>
        <field name="arch" type="xml">
            <form string="توجيه إداري للمناديب">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="عنوان التوجيه"/>
                        <h1>
                            <field name="name" placeholder="مثال: تعديل خطة السير العاجلة / هدف الأسبوع"/>
                        </h1>
                    </div>
                    <group>
                        <group string="إعدادات ونوع التوجيه">
                            <field name="directive_type" widget="radio"/>
                            <field name="is_active"/>
                        </group>
                        <group string="نطاق الاستهداف">
                            <field name="target_type" widget="radio"/>
                            <field name="delegate_ids" widget="many2many_tags" 
                                   invisible="target_type != 'specific'"
                                   placeholder="اختر المناديب المستهدفين بهذا التوجيه فقط..."/>
                        </group>
                    </group>
                    <group string="فترة الصلاحية">
                        <group>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="نص التوجيه والتعليمات للمندوب">
                            <field name="body" placeholder="اكتب التعليمات التي ستظهر للمندوب داخل تطبيق الموبايل..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Directive - Search View -->
    <record id="view_delegate_directive_search" model="ir.ui.view">
        <field name="name">delegate.directive.search</field>
        <field name="model">delegate.directive</field>
        <field name="arch" type="xml">
            <search string="بحث التوجيهات">
                <field name="name"/>
                <field name="body"/>
                <separator/>
                <filter string="نشط" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="عاجل" name="urgent" domain="[('directive_type', '=', 'urgent')]"/>
                <filter string="أهداف بيعية" name="target" domain="[('directive_type', '=', 'target')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="نوع التوجيه" name="group_by_type" context="{'group_by': 'directive_type'}"/>
                    <filter string="المستهدفون" name="group_by_target" context="{'group_by': 'target_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Directive -->
    <record id="action_delegate_directive" model="ir.actions.act_window">
        <field name="name">التوجيهات والتعليمات الإدارية</field>
        <field name="res_model">delegate.directive</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_delegate_directive_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ أول توجيه إداري لمندوبيك!
            </p>
            <p>
                يمكنك إرسال تنبيهات عاجلة تظهر كشريط أعلى شاشة التطبيق الرئيسية، أو إرسال أهداف بيعية وتنبيهات عامة لجميع المناديب أو لمناديب محددين.
            </p>
        </field>
    </record>

    <!-- Submenu Item under Root Menu (Sequence=13) -->
    <menuitem id="menu_delegate_directive"
              name="التوجيهات والإشعارات الإدارية"
              parent="menu_delegate_tracking_root"
              action="action_delegate_directive"
              sequence="13"/>
</odoo>
