<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expense - List View -->
    <record id="view_delegate_expense_tree" model="ir.ui.view">
        <field name="name">delegate.expense.list</field>
        <field name="model">delegate.expense</field>
        <field name="arch" type="xml">
            <list string="Delegate Expenses">
                <field name="date"/>
                <field name="delegate_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="amount" sum="Total Expenses"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Expense - Form View -->
    <record id="view_delegate_expense_form" model="ir.ui.view">
        <field name="name">delegate.expense.form</field>
        <field name="model">delegate.expense</field>
        <field name="arch" type="xml">
            <form string="Delegate Expense">
                <header>
                    <button name="action_approve" string="Approve / اعتماد" type="object" class="btn-success" invisible="state != 'draft'"/>
                    <button name="action_reject" string="Reject / رفض" type="object" class="btn-danger" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Expense Reason / بيان النفقة"/>
                        <h1>
                            <field name="name" placeholder="مثال: بنزين الرحلة"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="delegate_id"/>
                            <field name="category"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="receipt_image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Notes / ملاحظات إضافية">
                        <field name="notes" placeholder="ملاحظات توضيحية من المندوب..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Expense - Search View -->
    <record id="view_delegate_expense_search" model="ir.ui.view">
        <field name="name">delegate.expense.search</field>
        <field name="model">delegate.expense</field>
        <field name="arch" type="xml">
            <search string="Search Expenses">
                <field name="delegate_id"/>
                <field name="name"/>
                <field name="category"/>
                <filter string="Draft / قيد المراجعة" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved / معتمدة" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <group name="group_by">
                    <filter string="Delegate / المندوب" name="group_delegate" context="{'group_by': 'delegate_id'}"/>
                    <filter string="Category / التصنيف" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Date / التاريخ" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Expenses -->
    <record id="action_delegate_expense" model="ir.actions.act_window">
        <field name="name">نفقات المناديب (Expenses)</field>
        <field name="res_model">delegate.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_delegate_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                لا توجد نفقات مسجلة للمناديب
            </p>
            <p>
                تظهر هنا النفقات والمصاريف المسجلة من تطبيق المندوب للمراجعة والاعتماد.
            </p>
        </field>
    </record>
</odoo>
